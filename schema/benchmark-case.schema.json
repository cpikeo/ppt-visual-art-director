{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvad.local/schema/benchmark-case.schema.json",
  "title": "Independent project benchmark case governance record",
  "type": "object",
  "required": ["schema", "case_id", "project_type", "status", "exposure", "inputs", "target_environment", "expert_labels", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "pvad-benchmark-case-v1"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "project_type": {"enum": ["business_review", "fundraising_pitch", "project_proposal", "product_launch", "training", "data_report", "existing_pptx_revision"]},
    "status": {"enum": ["DRAFT", "FROZEN", "EXPOSED_REGRESSION"]},
    "exposure": {
      "type": "object",
      "required": ["created_without_implementation_access", "first_used_at", "exposed_to_implementers_at"],
      "additionalProperties": false,
      "properties": {
        "created_without_implementation_access": {"type": "boolean"},
        "first_used_at": {"type": ["string", "null"]},
        "exposed_to_implementers_at": {"type": ["string", "null"]}
      }
    },
    "inputs": {
      "type": "object",
      "required": ["brief_sha256", "source_package_sha256"],
      "additionalProperties": false,
      "properties": {
        "brief_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "source_package_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "target_environment": {
      "type": "object",
      "required": ["powerpoint_version", "operating_system", "fonts"],
      "additionalProperties": false,
      "properties": {
        "powerpoint_version": {"type": ["string", "null"]},
        "operating_system": {"type": ["string", "null"]},
        "fonts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "expert_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer_id", "independent", "label_file_sha256"],
        "additionalProperties": false,
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1},
          "independent": {"const": true},
          "label_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["candidate_pptx_sha256", "baseline_pptx_sha256", "blind_pack_sha256"],
      "additionalProperties": false,
      "properties": {
        "candidate_pptx_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "baseline_pptx_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "blind_pack_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "FROZEN"}}},
      "then": {
        "properties": {
          "expert_labels": {"minItems": 2},
          "exposure": {"properties": {"created_without_implementation_access": {"const": true}, "first_used_at": {"type": "string"}}},
          "inputs": {"properties": {"brief_sha256": {"type": "string"}, "source_package_sha256": {"type": "string"}}},
          "artifacts": {"properties": {"candidate_pptx_sha256": {"type": "string"}, "baseline_pptx_sha256": {"type": "string"}, "blind_pack_sha256": {"type": "string"}}}
        }
      }
    }
  ]
}
