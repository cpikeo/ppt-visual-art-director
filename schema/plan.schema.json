{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://pvad.local/schema/plan.schema.json",
 "title": "PVAD plan (judgment output)",
 "description": "逐页判断的契约：每条判断必须带 source（author/rule:<id>/absent）、why；判不出来就记 absent，不得省略字段。",
 "type": "object",
 "required": [
  "schema",
  "policy_sha256",
  "brief_sha256",
  "deck",
  "pages"
 ],
 "additionalProperties": true,
 "properties": {
  "schema": {
   "type": "string",
   "const": "pvad-plan-v1"
  },
  "policy_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "brief_sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "deck": {
   "type": "object",
   "required": [
    "visual_world",
    "coherence",
    "warnings"
   ],
   "properties": {
    "audience": {
     "type": "string"
    },
    "decision": {
     "type": "string"
    },
    "tension": {
     "type": "string"
    },
    "visual_world": {
     "type": "string",
     "minLength": 1
    },
    "coherence": {
     "type": "object",
     "required": [
      "climax"
     ],
     "properties": {
      "climax": {
       "type": [
        "string",
        "null"
       ]
      },
      "why": {
       "type": "string"
      }
     }
    },
    "warnings": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "code",
       "detail"
      ],
      "properties": {
       "code": {
        "type": "string"
       },
       "field": {
        "type": "string"
       },
       "detail": {
        "type": "string"
       }
      }
     }
    }
   }
  },
  "pages": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "understanding",
     "claim",
     "decision",
     "production",
     "open_questions"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "index": {
      "type": "integer",
      "minimum": 0
     },
     "title": {
      "type": "string"
     },
     "understanding": {
      "type": "object",
      "required": [
       "evidence",
       "comparison",
       "denominator",
       "numeric_density"
      ],
      "properties": {
       "evidence": {
        "type": "object",
        "required": [
         "value",
         "source",
         "why"
        ],
        "properties": {
         "value": {
          "enum": [
           "comparison",
           "series",
           "part_whole",
           "number",
           "structure",
           "sequence",
           "proposition",
           "none"
          ]
         },
         "source": {
          "type": "string",
          "pattern": "^(author|author:chart|rule:.+|absent)$"
         },
         "why": {
          "type": "string",
          "minLength": 1
         }
        }
       },
       "comparison": {
        "type": "object",
        "required": [
         "delta"
        ],
        "properties": {
         "delta": {
          "type": "boolean"
         },
         "ends": {
          "type": "integer"
         },
         "same_unit": {
          "type": "boolean"
         }
        }
       },
       "denominator": {
        "type": "object",
        "required": [
         "proven",
         "why"
        ],
        "properties": {
         "proven": {
          "type": "boolean"
         },
         "why": {
          "type": "string"
         }
        }
       },
       "numeric_density": {
        "type": "number",
        "minimum": 0
       }
      }
     },
     "claim": {
      "type": "object",
      "required": [
       "text",
       "source",
       "form",
       "why"
      ],
      "properties": {
       "text": {
        "type": "string"
       },
       "source": {
        "enum": [
         "author",
         "derived",
         "absent"
        ]
       },
       "form": {
        "enum": [
         "comparative",
         "numeric",
         "imperative",
         "conclusion",
         "description",
         "none"
        ]
       },
       "why": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "decision": {
      "type": "object",
      "required": [
       "composition",
       "density",
       "focus",
       "media",
       "rhythm",
       "role"
      ],
      "properties": {
       "role": {
        "enum": [
         "establish",
         "explain",
         "compare",
         "prove",
         "persuade",
         "summarize"
        ]
       },
       "composition": {
        "enum": [
         "statement",
         "metric_row",
         "two_end",
         "series_chart",
         "part_whole",
         "sequence_steps",
         "structure_map",
         "editorial_text",
         "image_narrative"
        ]
       },
       "focus": {
        "enum": [
         "claim",
         "metric",
         "chart",
         "subject",
         "step",
         "decision"
        ]
       },
       "density": {
        "enum": [
         "sparse",
         "balanced",
         "dense"
        ]
       },
       "emphasis": {
        "enum": [
         "lead",
         "normal",
         "quiet"
        ]
       },
       "composition_why": {
        "type": "string",
        "minLength": 1
       },
       "rhythm": {
        "type": "object",
        "required": [
         "move",
         "why"
        ],
        "properties": {
         "move": {
          "enum": [
           "open",
           "build",
           "turn",
           "hold",
           "breathe",
           "close"
          ]
         },
         "why": {
          "type": "string"
         },
         "previous": {
          "type": [
           "string",
           "null"
          ]
         }
        }
       },
       "media": {
        "type": "object",
        "required": [
         "decision",
         "source",
         "why"
        ],
        "properties": {
         "decision": {
          "enum": [
           "none",
           "required",
           "existing"
          ]
         },
         "role": {
          "type": "string"
         },
         "function": {
          "type": "string"
         },
         "reason": {
          "type": "string"
         },
         "source": {
          "type": "string",
          "pattern": "^(author|rule:.+|absent)$"
         },
         "why": {
          "type": "string",
          "minLength": 1
         },
         "path": {
          "type": "string"
         },
         "fit": {
          "type": "string"
         },
         "safe_area": {
          "type": [
           "object",
           "null"
          ]
         },
         "text_color": {
          "type": "string"
         },
         "hint": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "subject": {
          "type": "string"
         },
         "avoid": {
          "type": "array",
          "items": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "production": {
      "type": "object",
      "required": [
       "must_place",
       "must_not",
       "typography"
      ],
      "properties": {
       "must_place": {
        "type": "array"
       },
       "must_not": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "typography": {
        "type": "object"
       }
      }
     },
     "open_questions": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "code",
        "question"
       ],
       "properties": {
        "code": {
         "type": "string"
        },
        "question": {
         "type": "string"
        },
        "why": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 }
}
