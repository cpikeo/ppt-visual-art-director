{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://pvad.local/schema/composition.schema.json",
 "title": "PVAD composition recipes",
 "description": "构图配方的结构约束。引用完整性（槽位字号必须在 scale 里、类型必须在 enums、配方必须在 enums.composition 里）由 scripts/policy.py 校验。",
 "type": "object",
 "required": [
  "version",
  "id",
  "recipes"
 ],
 "additionalProperties": false,
 "properties": {
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "id": {
   "type": "string"
  },
  "default_gutter_px": {
   "type": "number",
   "minimum": 0
  },
  "recipes": {
   "type": "object",
   "minProperties": 3,
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "why",
     "fails",
     "when",
     "slots",
     "must_not",
     "ladder",
     "focus"
    ],
    "properties": {
     "why": {
      "type": "string",
      "minLength": 8
     },
     "fails": {
      "type": "string",
      "minLength": 8
     },
     "when": {
      "type": "string",
      "minLength": 4
     },
     "slots": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "role",
        "type",
        "zone"
       ],
       "properties": {
        "role": {
         "type": "string",
         "minLength": 1
        },
        "type": {
         "type": "string",
         "minLength": 1
        },
        "zone": {
         "type": "array",
         "minItems": 4,
         "maxItems": 4,
         "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         }
        },
        "size": {
         "type": "string"
        },
        "color": {
         "type": "string"
        },
        "bold": {
         "type": "boolean"
        },
        "align": {
         "type": "string",
         "enum": [
          "left",
          "center",
          "right"
         ]
        },
        "anchor": {
         "type": "string",
         "enum": [
          "top",
          "middle",
          "bottom"
         ]
        },
        "optional": {
         "type": "boolean"
        },
        "shape": {
         "type": "string"
        }
       }
      }
     },
     "must_not": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 4
      },
      "description": "这个配方下「不该做什么」。属于设计判断，因此放在策略里并按配方声明，不写在 Python 里；plan.production.must_not 直接取这一条。"
     },
     "ladder": {
      "type": "string",
      "minLength": 2
     },
     "focus": {
      "type": "string",
      "enum": [
       "claim",
       "metric",
       "chart",
       "subject",
       "step",
       "decision"
      ]
     }
    }
   }
  }
 }
}
