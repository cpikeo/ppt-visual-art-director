{
  "_readme": "技术阈值与运行时默认值的唯一来源。设计判断不在这里：这里只有脚本必须一致执行的数值。改这里之前先确认它在 compile.py 或 verify.py 里真的被读取。",

  "canvas": {
    "16:9": [13.333, 7.5],
    "4:3": [10.0, 7.5],
    "default": "16:9",
    "bound_tolerance_in": 0.02
  },

  "type": {
    "min_pt": {"title": 24, "number": 24, "body": 14, "text": 14, "caption": 12, "footer": 12},
    "default_pt": {"title": 40, "number": 72, "body": 20, "text": 20, "caption": 13, "footer": 13},
    "line_spacing": {"_readme": "行距 = 字号的倍数（em 行距），编译为固定磅值 a:spcPts，与字体自带行高无关；换字体行距不变。", "title": 1.2, "number": 1.0, "body": 1.5, "text": 1.5, "caption": 1.4, "footer": 1.4},
    "bold": {"title": true, "number": true, "caption": false},
    "inset_in": {"x": 0.05, "y": 0.03},
    "fit_tolerance": 1.05,
    "fit_width_safety": 0.96
  },

  "audit": {
    "_readme": "设计审计阈值（audit.py）。只是提示线，不是审美结论。",
    "edge_margin_in": 0.5, "edge_margin_v_in": 0.4,
    "axis_cluster_in": 0.06, "max_axes": 5,
    "min_dominance_ratio": 1.25, "dominant_area_share": 0.2,
    "max_measure_cjk": 32, "max_chars_page": 160,
    "max_families": 2, "max_type_steps": 6, "min_step_ratio": 1.15, "max_title_sizes": 2,
    "ink_threshold": 24, "empty_ink": 0.012, "crowd_ink": 0.6, "render_edge_in": 0.3,
    "centroid_dx": 0.2, "centroid_dy": 0.18, "flat_tone_range": 0.04
  },

  "geometry": {
    "overlap_area_sq_in": 0.5,
    "overlap_min_edge_in": 0.05,
    "overlap_ratio": 0.25,
    "stroke_default_pt": 0.75
  },

  "image": {
    "min_ppi": 72,
    "max_crop_loss": 0.72,
    "zone": {
      "_readme": "文字下方图像的静态量测：达标像素占比下限、灰度标准差上限（纹理强度，0–255）、采样边长。量的是文字框整体，偏保守。",
      "min_ok_share": 0.9,
      "max_gray_std": 42,
      "samples": 40
    }
  },

  "package": {
    "max_unpacked_mb": 1024
  },

  "contrast": {
    "normal": 4.5,
    "large": 3.0,
    "large_pt": 24,
    "dark_background_luminance": 0.18
  },

  "chart": {
    "min_contrast": {"bar": 2.0, "line": 3.0, "area": 2.0, "pie": 2.0, "donut": 2.0, "scatter": 3.0},
    "deemphasis": {"light": "#AEB3B8", "dark": "#50565E"},
    "font_pt": {"title": 15, "legend": 14, "axis": 14, "label": 14, "table": 16},
    "min_series_luminance_ratio": 1.4,
    "gap_width": 60,
    "stacked_overlap": 100,
    "style": {
      "light": {"title": "#111827", "body": "#374151", "grid": "#E5E7EB", "rule": "#D1D5DB"},
      "dark": {"title": "#F3F4F6", "body": "#D1D5DB", "grid": "#333A45", "rule": "#4B5563"}
    }
  },

  "page_number": {
    "corner": "bottom_right",
    "start": 1,
    "font_pt": 12,
    "box_in": {"w": 0.72, "h": 0.30},
    "margin_in": {"x": 0.62, "y": 0.42},
    "ink": {"light": "#111827", "dark": "#F3F4F6"}
  },

  "preview": {
    "dpi": 110,
    "blank_ink_ratio": 0.002,
    "contact_sheet_width_px": 1800
  },

  "render_check": {
    "_readme": "渲染核对用的容差与下限：span 归属容差、行归属容差、孤字判定所需的最少字数、旋转生效判定。",
    "span_tol_in": 0.2,
    "line_tol_in": 0.05,
    "orphan_min_chars": 8,
    "rotation_min_deg": 5,
    "rotation_tol_deg": 20
  },

  "font_aliases": {
    "_readme": "声明字族 → 可能的字体文件名（小写、去空格）。核验器用它判断“声明的字体是否真的参与了渲染”。只在能确定映射时写，不要猜。Noto CJK 以 .ttc 集合分发，LibreOffice 导出的 PDF 里字体名固定带集合首个字面的区域后缀（jp），所以 Noto 只能按到家族前缀匹配、无法在 PDF 里区分 SC/JP 字面。",
    "微软雅黑": ["microsoftyahei", "msyh"],
    "宋体": ["simsun"],
    "黑体": ["simhei"],
    "等线": ["dengxian"],
    "思源黑体": ["sourcehansans", "notosanscjk", "notosanssc"],
    "思源宋体": ["sourcehanserif", "notoserifcjk", "notoserifsc"],
    "苹方": ["pingfang"],
    "noto sans cjk sc": ["notosanscjk"],
    "noto serif cjk sc": ["notoserifcjk"]
  },

  "defaults": {
    "fonts": {"heading": "微软雅黑", "body": "微软雅黑"},
    "background": "#FFFFFF",
    "ink": "#1A1A1A",
    "ink_on_dark": "#F3F4F6",
    "palette": ["#2F5597", "#C55A11", "#2E7D5B", "#6A4C93", "#B08505", "#1F9DAA"]
  }
}
