{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slide plan",
  "description": "plan.json 的唯一数据契约：字段形状、必填与类型专属条件。技术数值见 limits.json；跨对象一致性（ID、引用、锚点、几何、重叠、图表口径、素材权利）由 compile.py 确定性检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["deck_id", "title", "audience", "goal", "core_claim", "brief", "pages"],
  "properties": {
    "deck_id": {"$ref": "#/$defs/str"},
    "title": {"$ref": "#/$defs/str"},
    "audience": {"$ref": "#/$defs/str", "description": "受众、已知与怀疑什么、观看环境与时长。"},
    "goal": {"$ref": "#/$defs/str", "description": "观众离场后应理解、记住或决定什么。"},
    "core_claim": {"$ref": "#/$defs/str", "description": "整稿最重要的一条主张。"},
    "brief": {"$ref": "#/$defs/brief"},
    "rhythm": {"type": "array", "items": {"$ref": "#/$defs/str"}, "description": "整稿乐谱：按页一句叙事动作与重量，条数与页数一致。"},
    "palette": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/color"}, "description": "图表消费色，按系列/类别顺序取用；缺省用 limits.json。"},
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"heading": {"$ref": "#/$defs/str"}, "body": {"$ref": "#/$defs/str"},
                     "number": {"$ref": "#/$defs/str", "description": "关键数字的字族；缺省同 heading。等宽或窄体数字常与标题字族分开。"}}
    },
    "aspect_ratio": {"enum": ["16:9", "4:3"]},
    "page_numbers": {"$ref": "#/$defs/pageNumbers"},
    "assets": {"type": "object", "additionalProperties": {"$ref": "#/$defs/asset"}},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "str": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "textType": {"enum": ["title", "body", "text", "number", "caption", "footer"]},

    "brief": {
      "type": "object", "additionalProperties": false,
      "required": ["insight", "concept", "veto"],
      "properties": {
        "insight": {"$ref": "#/$defs/str", "description": "观众原本以为什么、证据说明什么、差距在哪。写不出就不是洞察。"},
        "concept": {"$ref": "#/$defs/str", "description": "用什么视觉关系让这条洞察被看见。"},
        "veto": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/str"},
          "description": "据此否决的具体做法（某张图、某个配色、某种版式）。否决不了任何东西的概念没有指导力。"
        },
        "art": {
          "type": "object", "additionalProperties": false,
          "required": ["light", "lens", "material", "gamut", "grain"],
          "properties": {
            "light": {"$ref": "#/$defs/str", "description": "硬光/柔光、方向、色温。"},
            "lens": {"$ref": "#/$defs/str", "description": "视角与景别：平视/俯视/微距；全景/中景/特写。"},
            "material": {"$ref": "#/$defs/str", "description": "材质与表面：石、纸、金属、织物；哑或亮。"},
            "gamut": {"$ref": "#/$defs/str", "description": "主色相范围、饱和度上限、是否允许纯黑纯白。"},
            "grain": {"$ref": "#/$defs/str", "description": "干净数码/细颗粒/浅景深/长焦压缩。"}
          }
        },
        "motif": {"type": "array", "items": {"$ref": "#/$defs/str"}, "description": "一到两个跨页复现的装置；多了就不成母题。"}
      }
    },

    "pageNumbers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corner": {"enum": ["top_right", "bottom_right"]},
        "start": {"type": "integer", "minimum": 1},
        "hide": {"type": "array", "items": {"$ref": "#/$defs/str"}, "description": "不显示页码的页面 id；须在交付说明里写理由。"}
      }
    },

    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"$ref": "#/$defs/str", "description": "来源：拍摄、机构、URL 或生成工具。"},
        "generated": {"type": "boolean", "description": "与 generation 是否存在必须一致（编译器校验）；生成图不得作证据。"},
        "used_as_evidence": {"type": "boolean"},
        "rights": {"enum": ["cleared", "pending", "blocked"], "description": "版权与肖像/隐私的可确认状态；缺省 pending。"},
        "reference": {"type": "string", "description": "凭据位置（合同、授权页、编号）；rights=cleared 时应有，缺则提示。"},
        "generation": {"$ref": "#/$defs/generation"},
        "notes": {"type": "string"}
      }
    },

    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "prompt", "file", "status", "sha256"],
      "properties": {
        "tool": {"$ref": "#/$defs/str"},
        "prompt": {"$ref": "#/$defs/str", "description": "实际提交的完整提示词。"},
        "file": {"$ref": "#/$defs/str", "description": "实际落盘文件；必须与页面 image_id 解析到同一物理文件。"},
        "status": {"enum": ["generated", "pending", "failed"]},
        "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
        "note": {"type": "string"}
      }
    },

    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "focus", "elements"],
      "properties": {
        "id": {"$ref": "#/$defs/str"},
        "role": {"enum": ["open", "build", "breathe", "turn", "hold", "close"]},
        "claim": {"type": "string", "description": "本页主张；封面与过渡可留空。"},
        "focus": {"$ref": "#/$defs/str", "description": "读者这一页先看到什么、按什么顺序读。"},
        "focus_element": {"type": "string", "description": "承担主角的元素 id；有意并列或跨元素关系时不写。"},
        "composition_rationale": {"type": "string", "description": "重心如何成立、为什么这样断、放弃了什么方案。"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/str"}, "description": "支持本页主张的事实与来源。"},
        "open_questions": {"type": "array", "items": {"$ref": "#/$defs/str"}},
        "background": {"$ref": "#/$defs/color"},
        "page_number_tone": {"enum": ["light", "dark"], "description": "页码所在角区的实际明度场；仅当与 background 不同时声明。"},
        "notes": {"type": "string", "description": "设计备注；不写入演讲者备注。"},
        "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}}
      }
    },

    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/str"},
        "type": {"enum": ["title", "body", "text", "number", "image", "chart", "shape", "divider", "path", "group", "caption", "footer"]},
        "x": {"type": "number", "description": "左边缘，英寸。path/group 不需要（由点集或子元素推出）。"},
        "y": {"type": "number", "description": "上边缘，英寸，向下为正。"},
        "w": {"type": "number", "exclusiveMinimum": 0},
        "h": {"type": "number", "exclusiveMinimum": 0},
        "content": {"type": "string", "description": "文本内容；\\n 分段。"},
        "font_size": {"type": "number", "exclusiveMinimum": 0},
        "font": {"$ref": "#/$defs/str"},
        "line_spacing": {"type": "number", "minimum": 0.8, "maximum": 3.0},
        "letter_spacing_pt": {"type": "number", "minimum": -4, "maximum": 20},
        "space_after_pt": {"type": "number", "minimum": 0, "maximum": 72},
        "valign": {"enum": ["top", "middle", "bottom"]},
        "align": {"enum": ["left", "center", "right", "justify"]},
        "bold": {"type": "boolean"},
        "pad_in": {"type": "number", "minimum": 0, "maximum": 1, "description": "文本框内边距（英寸，四边同值）。贴网格轴线的文字写 0，缺省 0.05/0.03。"},
        "color": {"$ref": "#/$defs/color", "description": "文本为墨色；shape/divider/path 为填充色。"},
        "runs": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/run"},
          "description": "内联片段，可含 \\n 分段；拼接须与 content 逐字相等。"
        },

        "shape_kind": {"enum": ["rect", "round_rect", "oval", "triangle", "diamond", "chevron", "arrow_right", "arrow_up"]},
        "corner_in": {"type": "number", "minimum": 0, "maximum": 6, "description": "仅 round_rect：圆角半径（英寸），按短边裁剪。不给就用渲染器默认（约 16.7%）。"},
        "stroke": {"$ref": "#/$defs/stroke"},
        "gradient": {"$ref": "#/$defs/gradient"},
        "fill_alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "rotation": {"type": "number", "minimum": -360, "maximum": 360, "description": "顺时针角度；group 上表示整组旋转。任意角度按 360 取模写入（-90 与 270 等价）。"},
        "overlap_allowed": {"type": "boolean", "description": "仅承载元素（背景图、蒙版、色块、闭合路径）可声明：允许后面声明的元素压在它上面。"},

        "points": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/point"}, "description": "path 的顶点，英寸；可用元素锚点代替坐标。"},
        "closed": {"type": "boolean", "description": "闭合路径按 color 填充。"},
        "arrow": {"enum": ["none", "end", "both"], "description": "路径端点箭头。"},

        "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}, "description": "group 的子元素；使用页面绝对坐标。"},

        "image_id": {"$ref": "#/$defs/str"},
        "image_role": {"enum": ["background", "subject", "detail", "evidence", "texture"]},
        "crop_focus": {"$ref": "#/$defs/crop"},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "图片不透明度。"},
        "duotone": {
          "type": "object", "additionalProperties": false, "required": ["dark", "light"],
          "properties": {"dark": {"$ref": "#/$defs/color"}, "light": {"$ref": "#/$defs/color"}},
          "description": "把图压进整稿色域：暗部与亮部各一个颜色。原生可编辑，随时可摘；PowerPoint 生效，LibreOffice 只做去饱和。"
        },
        "asset_reason": {"$ref": "#/$defs/str", "description": "这张图承担什么职责；删掉会损失什么。"},

        "chart": {"$ref": "#/$defs/chart"}
      },
      "allOf": [
        {"if": {"required": ["type"], "properties": {"type": {"$ref": "#/$defs/textType"}}}, "then": {"required": ["content", "x", "y", "w", "h"]}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "image"}}}, "then": {"required": ["image_id", "asset_reason", "x", "y", "w", "h"]}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "chart"}}}, "then": {"required": ["chart", "x", "y", "w", "h"]}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "shape"}}}, "then": {"required": ["x", "y", "w", "h"], "anyOf": [{"required": ["color"]}, {"required": ["gradient"]}, {"required": ["stroke"]}]}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "divider"}}}, "then": {"required": ["color", "x", "y", "w", "h"]}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "path"}}}, "then": {"required": ["points", "stroke"]}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "group"}}}, "then": {"required": ["elements"]}},

        {"if": {"required": ["chart"]}, "then": {"properties": {"type": {"const": "chart"}}}},
        {"if": {"required": ["image_id"]}, "then": {"properties": {"type": {"const": "image"}}}},
        {"if": {"required": ["points"]}, "then": {"properties": {"type": {"const": "path"}}}},
        {"if": {"required": ["elements"]}, "then": {"properties": {"type": {"const": "group"}}}},
        {"if": {"required": ["content"]}, "then": {"properties": {"type": {"$ref": "#/$defs/textType"}}}},
        {"if": {"required": ["runs"]}, "then": {"properties": {"type": {"$ref": "#/$defs/textType"}}}}
      ]
    },

    "point": {
      "oneOf": [
        {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        {
          "type": "object", "additionalProperties": false, "required": ["el", "anchor"],
          "properties": {
            "el": {"$ref": "#/$defs/str"},
            "anchor": {"enum": ["left", "right", "top", "bottom", "center"]},
            "at": {"type": "number", "minimum": 0, "maximum": 1, "description": "沿该边的位置，0–1，缺省 0.5。"}
          }
        }
      ]
    },

    "stroke": {
      "type": "object", "additionalProperties": false, "required": ["color"],
      "properties": {
        "color": {"$ref": "#/$defs/color"},
        "width_pt": {"type": "number", "exclusiveMinimum": 0, "maximum": 12},
        "dash": {"enum": ["solid", "dash", "dot", "dash_dot", "long_dash"]},
        "cap": {"enum": ["flat", "round", "square"]}
      }
    },

    "gradient": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "angle"],
      "properties": {
        "from": {"$ref": "#/$defs/color"},
        "to": {"$ref": "#/$defs/color"},
        "angle": {"type": "number", "minimum": -180, "maximum": 180, "description": "0 = 从左到右，90 = 从上到下。"},
        "from_alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "to_alpha": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },

    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}}
    },

    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "font": {"$ref": "#/$defs/str"},
        "font_size": {"type": "number", "exclusiveMinimum": 0},
        "bold": {"type": "boolean"},
        "color": {"$ref": "#/$defs/color"},
        "letter_spacing_pt": {"type": "number", "minimum": -4, "maximum": 20}
      }
    },

    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data"],
      "properties": {
        "kind": {"enum": ["bar", "line", "area", "pie", "donut", "scatter", "table"]},
        "data": {"oneOf": [{"$ref": "#/$defs/seriesData"}, {"$ref": "#/$defs/xyData"}, {"$ref": "#/$defs/tableData"}]},
        "title": {"type": "string", "description": "图题：说结论，不是话题。"},
        "unit": {"type": "string", "description": "数量级+量纲；写进图题与核验。"},
        "period": {"type": "string"},
        "basis": {"type": "string", "description": "口径/分母/统计方式。"},
        "show_title": {"type": "boolean"},
        "legend": {"type": "boolean", "description": "图例开关；缺省两个以上系列时显示。能直标就不要图例。"},
        "data_labels": {"type": "boolean", "description": "柱/线/面积/饼/环的直标；组合图只作用于柱层。"},
        "combo_line_labels": {"type": "boolean", "description": "仅组合图：给折线层加直标。标签会落在柱体上，通常不要开。"},
        "horizontal": {"type": "boolean", "description": "仅 bar：横向条形。"},
        "stacked": {"oneOf": [{"type": "boolean"}, {"const": "percent"}], "description": "仅 bar/area：堆叠；percent 为百分比堆叠（仅 bar）。"},
        "combo_line_series": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/str"}, "description": "仅 bar：这些系列改画折线（共用数值轴）。"},
        "highlight_category": {"type": "integer", "minimum": 0, "description": "仅单系列、非堆叠柱/条：该类别用调色板首色，其余退中性。"},
        "axis_labels": {"type": "boolean", "description": "false 时整根数值轴不画，须 data_labels=true。"},
        "value_axis": {"$ref": "#/$defs/valueAxis"},
        "axis_titles": {
          "type": "object", "additionalProperties": false,
          "properties": {"x": {"$ref": "#/$defs/str"}, "y": {"$ref": "#/$defs/str"}},
          "description": "轴名；散点与双量纲对照必须写，否则读者不知道哪个轴是什么。"
        },
        "gap_width": {"type": "integer", "minimum": 0, "maximum": 500, "description": "仅 bar：柱宽间隙百分比，越小柱越粗。"},
        "column_weights": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "description": "仅表格列宽权重。"},
        "column_align": {"type": "array", "items": {"enum": ["left", "center", "right"]}, "description": "仅表格：逐列对齐；数字列右对齐。"}
      }
    },

    "valueAxis": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"},
        "major_unit": {"type": "number", "exclusiveMinimum": 0},
        "number_format": {"type": "string"},
        "note": {"$ref": "#/$defs/str", "description": "截轴或非零起点时必须写：读者要看到起点不是零。"}
      }
    },

    "seriesData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "series"],
      "properties": {
        "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": ["string", "number"]}},
        "series": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "values"],
            "properties": {
              "name": {"$ref": "#/$defs/str"},
              "values": {"type": "array", "minItems": 1, "items": {"type": "number"}},
              "unit": {"type": "string"},
              "period": {"type": "string"},
              "basis": {"type": "string"}
            }
          }
        }
      }
    },

    "xyData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series"],
      "properties": {
        "series": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "points"],
            "properties": {
              "name": {"$ref": "#/$defs/str"},
              "points": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
              "unit": {"type": "string"},
              "period": {"type": "string"},
              "basis": {"type": "string"}
            }
          }
        }
      }
    },

    "tableData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headers", "rows"],
      "properties": {
        "headers": {"type": "array", "minItems": 1, "items": {"type": ["string", "number"]}},
        "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": ["string", "number"]}}}
      }
    }
  }
}
